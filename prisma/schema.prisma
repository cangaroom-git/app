generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRAVELLER
  HOTEL_OWNER
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING_REVIEW
  VERIFIED
  SUSPENDED
}

enum PinMediaType {
  PHOTO
  CAROUSEL
  VIDEO
}

enum PinCategory {
  ROOMS
  VIEWS
  VIDEOS
  DINING
  REVIEWS
}

enum SocialPlatform {
  MANUAL
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PinPublishStatus {
  PUBLISHED
  PENDING_APPROVAL
  DISCARDED
}

enum DealSourceType {
  INTERNAL
  EXTERNAL
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ShareChannel {
  LINE
  FACEBOOK
  COPY_LINK
  WEB_SHARE
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED_THB
}

enum PropertyType {
  BOUTIQUE_HOTEL
  RESORT
  POOL_VILLA
  GLAMPING_HOMESTAY
}

enum PlaceCategory {
  STAY
  CAFE
  RESTAURANT
  ATTRACTION
  WELLNESS
}

enum MerchantMode {
  DIRECT_BOOKING
  PROFILE_ONLY
}

enum PromoKind {
  BOOKING_COUPON
  ONSITE_PERK
  EXTERNAL_LINK_DEAL
}

enum HotelPostKind {
  FEED_POST
  BLOG
}

enum PlaceReportReason {
  DUPLICATE
  FAKE_SCAM
  CLOSED
  WRONG_LOCATION
  OTHER
}

enum PlaceReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DiscountRuleType {
  LENGTH_OF_STAY
  EARLY_BIRD
  LAST_MINUTE
}

enum BookingStatus {
  HOLD_PENDING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SocialPublishMode {
  ONE_CLICK_APPROVE
  AUTO_HIGH_CONFIDENCE
}

enum AdPlacement {
  HOME_FEED
  DEAL_FEATURED
  AGENT_PRIORITY
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum PostPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactChannel {
  LINE
  FACEBOOK_MESSENGER
  PHONE
}

enum TelemetryEventType {
  PIN_IMPRESSION
  PIN_OPEN
  PIN_DWELL
  CAROUSEL_SWIPE
  MEDIA_EXPAND
  VIDEO_PROGRESS
  PIN_SAVE
  PIN_LIKE
  PIN_SHARE
  HOTEL_PROFILE_VIEW
  ROOM_CALENDAR_SELECT
  COUPON_CLAIM
  BOOKING_INITIATE
  SEARCH_FILTER
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  phone        String?
  avatarUrl    String?
  role         UserRole           @default(TRAVELLER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ownedHotels  Hotel[]
  likes        PinLike[]
  comments     PinComment[]
  commentLikes PinCommentLike[]
  boards       SavedBoard[]
  boardPins    SavedBoardPin[]
  couponWallet    UserCouponWallet[]
  bookings        Booking[]
  tasteProfile    VisitorTasteProfile?
  telemetryEvents TelemetryEvent[]
}

model Hotel {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  ownerId              String
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nameTh               String
  nameEn               String              @default("")
  taglineTh            String              @default("")
  taglineEn            String              @default("")
  descriptionTh        String              @default("")
  descriptionEn        String              @default("")
  logoUrl              String?
  coverImageUrl        String?
  provinceId           String
  districtTh           String              @default("")
  addressTh            String              @default("")
  latitude             Float?
  longitude            Float?
  googleMapsUrl        String?
  stayStyles           String[]            @default([])
  checkInTime          String              @default("14:00")
  checkOutTime         String              @default("11:00")
  petsAllowed          Boolean             @default(false)
  petPolicyTh          String              @default("")
  highlightsJson       Json?
  nearbySpotsJson      Json?
  faqJson              Json?
  seasonalRulesJson    Json?
  contactPhone         String              @default("")
  contactLine          String              @default("")
  facebookPageUrl      String              @default("")
  instagramUrl         String              @default("")
  promptPayId          String              @default("")
  promptPayAccountName String              @default("")
  bankName             String              @default("")
  bankAccountNo        String              @default("")
  verificationStatus   VerificationStatus  @default(PENDING_REVIEW)
  propertyType         PropertyType        @default(BOUTIQUE_HOTEL)
  placeCategory        PlaceCategory       @default(STAY)
  merchantMode         MerchantMode        @default(DIRECT_BOOKING)
  externalWebsiteUrl   String              @default("")
  primaryCtaLabelTh    String              @default("")
  openingHoursJson     Json?
  googlePlaceId        String?
  canonicalPinId       String?
  featuredCouponId     String?
  isPublished          Boolean             @default(true)
  ratingAvg            Float               @default(4.9)
  reviewCount          Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  rooms                Room[]
  addons               HotelAddon[]
  pins                 Pin[]
  coupons              Coupon[]
  discountRules        HotelDiscountRule[]
  bookings             Booking[]
  reviews              GuestReview[]
  contactClicks        ContactClickLog[]
  socialConnections    SocialConnection[]
  campaigns            SponsoredCampaign[]
  posts                HotelPost[]
  reports              PlaceReport[]

  @@index([provinceId])
  @@index([ownerId])
  @@index([verificationStatus, isPublished])
  @@index([placeCategory, merchantMode, isPublished])
  @@index([latitude, longitude])
  @@index([googlePlaceId])
  @@index([canonicalPinId])
}

model Room {
  id                 String             @id @default(cuid())
  hotelId            String
  hotel              Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code               String
  slug               String
  nameTh             String
  nameEn             String             @default("")
  categoryTh         String             @default("Villa")
  categoryEn         String             @default("Villa")
  shortDescTh        String             @default("")
  shortDescEn        String             @default("")
  totalUnits         Int                @default(1)
  weekdayPriceThb    Int
  weekendPriceThb    Int
  extraGuestPriceThb Int                @default(0)
  sizeSqm            Int                @default(32)
  standardGuests     Int                @default(2)
  maxGuests          Int                @default(2)
  bedrooms           Int                @default(1)
  beds               Int                @default(1)
  bathrooms          Int                @default(1)
  petsAllowed        Boolean            @default(false)
  amenities          String[]           @default([])
  galleryUrls        String[]           @default([])
  galleryMetaJson    Json?
  isActive           Boolean            @default(true)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dateOverrides      RoomDateOverride[]
  pins               Pin[]
  bookings           Booking[]
  posts              HotelPost[]

  @@unique([hotelId, code])
  @@unique([hotelId, slug])
  @@index([hotelId, isActive, sortOrder])
}

model RoomDateOverride {
  id               String   @id @default(cuid())
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  blockedUnits     Int      @default(0)
  overridePriceThb Int?
  minNights        Int      @default(1)
  note             String?

  @@unique([roomId, date])
  @@index([roomId, date])
}

model HotelDiscountRule {
  id             String           @id @default(cuid())
  hotelId        String
  hotel          Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  ruleType       DiscountRuleType
  titleTh        String
  discountType   DiscountType     @default(PERCENT)
  discountValue  Int
  minNights      Int?
  minAdvanceDays Int?
  maxAdvanceDays Int?
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([hotelId, isActive, ruleType])
  @@index([hotelId, sortOrder])
}

model HotelAddon {
  id            String  @id @default(cuid())
  hotelId       String
  hotel         Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  nameTh        String
  nameEn        String  @default("")
  descriptionTh String  @default("")
  priceThb      Int
  unitLabelTh   String  @default("ชุด")
  unitLabelEn   String  @default("set")
  imageUrl      String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  @@index([hotelId, isActive])
}

model Pin {
  id                String            @id @default(cuid())
  hotelId           String
  hotel             Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId            String?
  room              Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  couponId          String?
  coupon            Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  mediaType         PinMediaType      @default(PHOTO)
  category          PinCategory       @default(VIEWS)
  titleTh           String
  titleEn           String            @default("")
  descriptionTh     String            @default("")
  descriptionEn     String            @default("")
  coverImageUrl     String
  mediaUrls         String[]          @default([])
  videoUrl          String?
  aspectRatio       String            @default("3/4")
  provinceId        String
  stayStyles        String[]          @default([])
  semanticTags      String[]          @default([])
  sourcePlatform     SocialPlatform    @default(MANUAL)
  dealSourceType     DealSourceType    @default(INTERNAL)
  externalDealUrl    String?
  externalSourceName String?
  promoHeadlineTh    String?
  promoHeadlineEn    String?
  promoCode          String?
  promoOriginalPriceThb Int?
  promoDealPriceThb  Int?
  promoExpiresAt     DateTime?
  externalClickCount Int               @default(0)
  externalPostId     String?
  externalPermalink  String?
  isCanonicalCard    Boolean           @default(true)
  publishStatus      PinPublishStatus  @default(PUBLISHED)
  aiConfidenceScore Int?
  aiTriageNote      String?
  isSponsored       Boolean           @default(false)
  sponsoredPriority Int               @default(0)
  likesCount        Int               @default(0)
  savesCount        Int               @default(0)
  commentsCount     Int               @default(0)
  sharesCount       Int               @default(0)
  viewsCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  likes             PinLike[]
  comments          PinComment[]
  shares            PinShare[]
  boardEntries      SavedBoardPin[]
  campaigns         SponsoredCampaign[]

  @@unique([hotelId, sourcePlatform, externalPostId])
  @@index([publishStatus, provinceId])
  @@index([publishStatus, isCanonicalCard, provinceId])
  @@index([publishStatus, dealSourceType, promoExpiresAt])
  @@index([publishStatus, isSponsored, sponsoredPriority, createdAt])
}

model PinLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinId     String
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, pinId])
  @@index([pinId])
}

model PinComment {
  id                String           @id @default(cuid())
  pinId             String
  pin               Pin              @relation(fields: [pinId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            PinComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           PinComment[]     @relation("CommentReplies")
  isHotelOwnerReply Boolean          @default(false)
  body              String
  likesCount        Int              @default(0)
  status            CommentStatus    @default(VISIBLE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  likes             PinCommentLike[]

  @@index([pinId, status, createdAt])
  @@index([parentId])
}

model PinCommentLike {
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   PinComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([userId, commentId])
}

model PinShare {
  id        String       @id @default(cuid())
  pinId     String
  pin       Pin          @relation(fields: [pinId], references: [id], onDelete: Cascade)
  userId    String?
  channel   ShareChannel @default(COPY_LINK)
  createdAt DateTime     @default(now())

  @@index([pinId, createdAt])
}

model SavedBoard {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  shareSlug String?         @unique
  isPublic  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  pins      SavedBoardPin[]

  @@index([userId, createdAt])
}

model SavedBoardPin {
  id                    String     @id @default(cuid())
  boardId               String
  board                 SavedBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pinId                 String
  pin                   Pin        @relation(fields: [pinId], references: [id], onDelete: Cascade)
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sortOrder             Int        @default(0)
  savedPriceSnapshotThb Int?
  createdAt             DateTime   @default(now())

  @@unique([boardId, pinId])
  @@index([userId, pinId])
  @@index([boardId, sortOrder, createdAt])
}

model Coupon {
  id             String              @id @default(cuid())
  hotelId        String
  hotel          Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code           String
  titleTh        String
  titleEn        String              @default("")
  descriptionTh  String              @default("")
  descriptionEn  String              @default("")
  coverImageUrl  String?
  promoKind      PromoKind           @default(BOOKING_COUPON)
  badgeTextTh    String              @default("")
  badgeTextEn    String              @default("")
  externalUrl    String?
  discountType   DiscountType        @default(FIXED_THB)
  discountValue  Int
  minSpendThb    Int                 @default(0)
  maxDiscountThb Int?
  totalQuota     Int?
  claimedCount   Int                 @default(0)
  usedCount      Int                 @default(0)
  startsAt       DateTime            @default(now())
  expiresAt      DateTime
  isFeaturedDeal Boolean             @default(false)
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  walletClaims   UserCouponWallet[]
  pins           Pin[]
  bookings       Booking[]
  campaigns      SponsoredCampaign[]

  @@unique([hotelId, code])
  @@index([isActive, isFeaturedDeal, expiresAt])
  @@index([hotelId, sortOrder])
}

model UserCouponWallet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId      String
  coupon        Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  claimedAt     DateTime  @default(now())
  usedAt        DateTime?
  usedBookingId String?

  @@unique([userId, couponId])
  @@index([userId, usedAt])
}

model Booking {
  id              String        @id @default(cuid())
  bookingCode     String        @unique
  hotelId         String
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  checkInDate     DateTime      @db.Date
  checkOutDate    DateTime      @db.Date
  nights          Int
  guests          Int
  unitsBooked     Int           @default(1)
  roomSubtotalThb Int
  addonsTotalThb  Int           @default(0)
  discountThb     Int           @default(0)
  netTotalThb     Int
  addonsJson      Json?
  guestName       String
  guestPhone      String
  guestEmail      String?
  guestLine       String?
  guestNote       String?
  slipImageUrl    String?
  slipQrPayload   String?       @unique
  holdExpiresAt   DateTime?
  status          BookingStatus @default(HOLD_PENDING_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([roomId, status, checkInDate, checkOutDate])
  @@index([hotelId, status, createdAt])
  @@index([userId, createdAt])
}

model GuestReview {
  id             String   @id @default(cuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookingId      String?  @unique
  userId         String?
  roomCode       String?
  authorName     String
  authorAvatar   String?
  rating         Int      @default(5)
  commentTh      String
  commentEn      String   @default("")
  photoUrls      String[]  @default([])
  isVerifiedStay Boolean   @default(true)
  ownerReplyTh   String?
  ownerRepliedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([hotelId, createdAt])
}

model ContactClickLog {
  id        String         @id @default(cuid())
  hotelId   String
  hotel     Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId    String?
  userId    String?
  channel   ContactChannel
  createdAt DateTime       @default(now())

  @@index([hotelId, channel, createdAt])
}

model SocialConnection {
  id               String            @id @default(cuid())
  hotelId          String
  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  platform         SocialPlatform    @default(FACEBOOK)
  externalPageId   String
  externalPageName String
  pageUrl          String?
  publishMode      SocialPublishMode @default(ONE_CLICK_APPROVE)
  excludedHashtags String[]          @default([])
  lastSyncedAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([hotelId, platform, externalPageId])
}

model SponsoredCampaign {
  id                 String         @id @default(cuid())
  hotelId            String
  hotel              Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  pinId              String?
  pin                Pin?           @relation(fields: [pinId], references: [id], onDelete: SetNull)
  couponId           String?
  coupon             Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  placement          AdPlacement    @default(HOME_FEED)
  dailyBudgetThb     Int            @default(300)
  impressions        Int            @default(0)
  clicks             Int            @default(0)
  bookingsAttributed Int            @default(0)
  startsAt           DateTime       @default(now())
  endsAt             DateTime
  status             CampaignStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())

  @@index([hotelId, status])
  @@index([placement, status])
}

model HotelPost {
  id            String            @id @default(cuid())
  hotelId       String
  hotel         Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  authorId      String?
  roomId        String?
  room          Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  slug          String
  titleTh       String
  titleEn       String            @default("")
  excerptTh     String            @default("")
  contentTh     String            @db.Text
  coverImageUrl String
  galleryUrls   String[]          @default([])
  categoryTh     String            @default("คู่มือเที่ยว & ที่พัก")
  postKind       HotelPostKind     @default(BLOG)
  sourcePlatform SocialPlatform    @default(MANUAL)
  externalPostId String?
  tags           String[]          @default([])
  status         PostPublishStatus @default(PUBLISHED)
  viewsCount     Int               @default(0)
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([hotelId, slug])
  @@index([hotelId, status, publishedAt])
  @@index([hotelId, postKind, status, publishedAt])
}

model PlaceReport {
  id             String            @id @default(cuid())
  hotelId        String
  hotel          Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reason         PlaceReportReason @default(OTHER)
  note           String            @default("")
  status         PlaceReportStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([hotelId, status])
}

model VisitorTasteProfile {
  id                  String   @id @default(cuid())
  visitorId           String   @unique
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentLevel        String   @default("ANALYTICS")
  consentUpdatedAt    DateTime @default(now())
  inferredProvinceId  String?
  inferredRegion      String?
  deviceType          String   @default("desktop")
  osFamily            String   @default("other")
  viewportBucket      String   @default("lg")
  preferredLang       String   @default("th")
  preferredTheme      String   @default("light")
  styleWeightsJson    Json     @default("{}")
  provinceWeightsJson Json     @default("{}")
  tagWeightsJson      Json     @default("{}")
  priceSumWeighted    Float    @default(0)
  priceWeightTotal    Float    @default(0)
  preferredGuests     Int      @default(2)
  recentViewedPinIds  String[] @default([])
  recentSkippedPinIds String[] @default([])
  totalSessions       Int      @default(1)
  totalPinOpens       Int      @default(0)
  totalDwellSec       Int      @default(0)
  lastActiveAt        DateTime @default(now())
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([lastActiveAt])
  @@index([expiresAt])
  @@index([inferredProvinceId])
}

model TelemetryEvent {
  id               String             @id @default(cuid())
  visitorId        String?
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String
  eventType        TelemetryEventType
  pinId            String?
  hotelId          String?
  provinceId       String?
  originProvinceId String?
  deviceType       String             @default("desktop")
  dwellMs          Int?
  carouselDepth    Int?
  metadataJson     Json?
  createdAt        DateTime           @default(now())
  expiresAt        DateTime

  @@index([hotelId, eventType, createdAt])
  @@index([pinId, eventType, createdAt])
  @@index([visitorId, createdAt])
  @@index([expiresAt])
}

model ApiQuotaUsage {
  id           String   @id @default(cuid())
  sku          String
  monthKey     String
  dayKey       String
  monthlyCount Int      @default(0)
  dailyCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sku, monthKey])
  @@index([monthKey])
}

model ThailandPlace {
  id              String   @id @default(cuid())
  source          String
  externalId      String
  nameTh          String
  nameEn          String   @default("")
  category        String
  subcategoryTh   String   @default("")
  subcategoryEn   String   @default("")
  provinceId      String?
  lat             Float
  lng             Float
  description     String?
  thumbnailUrl    String?
  popularityScore Int      @default(50)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([source, externalId])
  @@index([lat, lng])
  @@index([category, lat, lng])
  @@index([provinceId, category, popularityScore])
}
