generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Room {
  id              String    @id @default(cuid())
  slug            String    @unique
  code            String    @unique
  nameTh          String
  nameEn          String
  categoryTh      String
  categoryEn      String
  shortDescTh     String
  shortDescEn     String
  basePriceThb    Int
  weekendPriceThb Int
  sizeSqm         Int
  minGuests       Int       @default(1)
  maxGuests       Int       @default(2)
  bedrooms        Int       @default(1)
  beds            Int       @default(1)
  bathrooms       Int       @default(1)
  petsAllowed     Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  HOTEL_ADMIN
  GUEST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         UserRole @default(GUEST)
  provider     String   @default("EMAIL") // "GOOGLE" | "LINE" | "APPLE" | "EMAIL"
  providerId   String?
  hotelSlug    String?  // For HOTEL_ADMIN: links to their property tenant
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id            String        @id @default(cuid())
  bookingCode   String        @unique
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  checkInDate   DateTime
  checkOutDate  DateTime
  nights        Int
  guests        Int
  guestName     String
  guestPhone    String
  guestContact  String?
  guestNote     String?
  addonsJson    String?
  totalPriceThb Int
  slipImageUrl  String?
  status        BookingStatus @default(PENDING_PAYMENT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([roomId, checkInDate, checkOutDate])
}

model ShortVideo {
  id         String   @id @default(cuid())
  titleTh    String
  titleEn    String   @default("")
  captionTh  String   @default("")
  captionEn  String   @default("")
  videoUrl   String
  posterUrl  String
  audioLabel String   @default("")
  category   String   @default("mist")
  roomId     String?
  couponCode String?
  isPinned   Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, isPinned, sortOrder])
}

model GalleryAsset {
  id        String   @id @default(cuid())
  url       String
  captionTh String   @default("")
  captionEn String   @default("")
  category  String   @default("property")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
}

model SiteCmsState {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("site_cms_state")
}
